# secrets — never commit
.env
# real user database (password hashes) — template tracked as users_database.yml.example
compose/authelia/users_database.yml

# frontend
node_modules/
dist/
# package-lock.json is server-local state: `make update` keeps it current on
# the server (the Docker build uses it via npm ci there); a fresh clone has no
# lockfile and the build resolves from package.json's ranges instead. Keeping
# it out of git also keeps git pull conflict-free between updates and stops
# publishing exact resolved versions.
package-lock.json
package-lock.bak

# go
panel-do/panel-do

# python
__pycache__/
*.pyc
.venv/
# panel-api dev-mode LLM settings (PANEL_DEV=1 writes it in the CWD)
llm-settings.json

# runtime artifacts that may appear if the repo lives on the server
*.sqlite3
notification.txt
acme.json
