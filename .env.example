# ─────────────────────────────────────────────────────────────────────────────
# Panel deployment configuration.
# `make secrets` copies this to .env and fills the __*__ placeholders.
# Edit the REPLACE_ME values yourself.
# ─────────────────────────────────────────────────────────────────────────────

# NameSilo API key: Domain Manager → API → generate key. Used by Traefik
# (wildcard cert via DNS-01) and panel-ddns (keeps the apex A record current;
# *.pietrasik.top is a one-time manual CNAME → apex, which ddns never touches).
NAMESILO_API_KEY=REPLACE_ME

# NameSilo TTLs are slow; keep the long propagation timeout.
# Plain integer SECONDS — lego parses it with Atoi, so "30m" silently falls
# back to the 60s default.
NAMESILO_PROPAGATION_TIMEOUT=1800

# Let's Encrypt account email (expiry/abuse notices) — pre-filled; change if
# you want the notices in a different inbox.
ACME_EMAIL=connorgpietrasik@gmail.com

# Let's Encrypt ACME directory. FIRST bring-up runs against STAGING (no
# meaningful rate limits while you debug the DNS-01 challenge; staging certs
# are untrusted — expected). Once the staging cert issues, `make deploy`
# promotes to production automatically (stops traefik, wipes the ACME store —
# the staging account URI fails JWS verification on prod — flips config,
# restarts). Manual/idempotent fallback: make promote.
#   staging: https://acme-staging-v02.api.letsencrypt.org/directory
#   prod:    https://acme-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# How long `make deploy` waits for the staging cert before leaving promotion
# to a later `make promote` / `make deploy`. DNS-01 propagation is the slow
# part (minutes, not seconds). 0 = don't wait.
#ACME_STAGING_WAIT=600

# How long the promotion step waits for the PRODUCTION cert (warn-only on
# timeout — traefik keeps retrying).
#ACME_PROMOTE_WAIT=300

# Shared secret Traefik injects as X-Panel-Token on /api requests. The host
# API rejects anything else. Never shown to clients.
PANEL_TOKEN=__PANEL_TOKEN__

# Filesystems the panel Overview shows a storage row for (comma-separated).
# Every entry always shows up: stats, or a loud red row on the Overview — if
# it's listed here, you expect it to be there.
PANEL_DISK_MOUNTS=/,/home,/models

# LLM fleet: one shared API key for all instances (OpenAI-style bearer auth).
# A key authorizes LLM use, not a specific instance, so one value keeps client
# configs simple. Generate with: openssl rand -hex 32
# The LLM compose blocks fail fast at deploy time if unset; they map it to
# RADIANCE_API_KEY, read via radiance's --api-key-env, so the key never
# appears in argv.
#LLM_API_KEY=sk-REPLACE_ME

# Authelia secrets (generated). Rotate → change here + `docker compose up -d --force-recreate authelia`.
# session.secret
AUTHELIA_SESSION_SECRET=__AUTHELIA_SESSION_SECRET__
# storage.encryption_key (encrypts the sqlite TOTP/identity store — back this up!)
AUTHELIA_STORAGE_ENCRYPTION_KEY=__AUTHELIA_STORAGE_ENCRYPTION_KEY__
# identity_validation.reset_password.jwt_secret
AUTHELIA_JWT_SECRET=__AUTHELIA_JWT_SECRET__
