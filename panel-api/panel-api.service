[Unit]
Description=Panel API (host service behind panel.pietrasik.top/api)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
User=panel
Group=panel
WorkingDirectory=/opt/panel-api
# Reduced env file: ONLY the vars this API reads (PANEL_TOKEN, PANEL_DEV,
# PANEL_DISK_MOUNTS, and LLM_API_KEY — the LLM router's bearer gate; the one
# deliberately non-PANEL key), derived from /opt/panel/.env at deploy time
# (sync_panel_api_env, setup/common.sh). The full .env would also carry the
# Authelia secrets + NameSilo key into a long-lived panel-uid process's
# /proc/<pid>/environ — those stay out.
EnvironmentFile=/opt/panel/.panel-api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/panel-api/venv/bin/uvicorn main:app --host 172.17.0.1 --port 8010
Restart=on-failure
RestartSec=3

# ── hardening ────────────────────────────────────────────────────────────────
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
# Deliberately NOT enabled — they would break `sudo -n panel-do` (setuid) or
# the sysfs GPU reads the whole dashboard depends on:
#   NoNewPrivileges=yes, RestrictSUIDSGID=yes (sudo needs setuid)
#   PrivateDevices=yes, ProtectKernel* (service must read /sys/class/drm, /sys/class/hwmon)
#   CapabilityBoundingSet= (children spawned via sudo would lose needed privileges)

[Install]
WantedBy=multi-user.target
