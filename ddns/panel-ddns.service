[Unit]
Description=panel-ddns — reconcile the NameSilo apex A record with the public IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=panel
Group=panel
# Reduced env file: ONLY the vars this timer reads (NAMESILO_API_KEY,
# optional DDNS_HOSTS), derived from /opt/panel/.env at deploy time
# (sync_ddns_env, setup/common.sh). The script runs as the same uid as
# panel-api, so its environ is readable by a panel-uid process during each
# tick — the full .env (Authelia secrets, PANEL_TOKEN) is never in it.
# systemd reads the file as root; the oneshot re-reads it on every tick, so a
# rotated key is live on the next tick (no timer restart needed).
EnvironmentFile=/opt/panel/.panel-ddns.env
ExecStart=/usr/bin/python3 /opt/panel-ddns/ddns.py
TimeoutStartSec=5min

# ── hardening: outbound HTTP(S)/DNS only; the script writes nothing ──────────
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
